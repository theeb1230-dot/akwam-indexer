[Unit]
Description=Theeb Engine standby API
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/theeb/api.env
ExecStartPre=/usr/bin/test -r /etc/theeb/api.env
ExecStartPre=/bin/sh -c 'test "$(/usr/bin/stat -c %%a /etc/theeb/api.env)" = "600"'
ExecStartPre=/bin/sh -c 'test "$(/usr/bin/stat -c %%u /etc/theeb/api.env)" = "0"'
ExecStartPre=/usr/bin/test -r /etc/theeb/secrets/database-url
ExecStartPre=/bin/sh -c 'test "$(/usr/bin/stat -c %%a /etc/theeb/secrets/database-url)" = "600"'
ExecStartPre=/bin/sh -c 'test "$(/usr/bin/stat -c %%u /etc/theeb/secrets/database-url)" = "0"'
ExecStartPre=/usr/bin/docker pull THEEB_API_IMAGE
ExecStartPre=-/usr/bin/docker rm -f theeb-api
ExecStart=/usr/bin/docker run --rm --name theeb-api --env-file /etc/theeb/api.env --mount type=bind,src=/etc/theeb/secrets/database-url,dst=/run/secrets/database_url,readonly -e THEEB_ROLE=api -p 127.0.0.1:8080:8080 --init --stop-timeout 30 --read-only --tmpfs /tmp:rw,noexec,nosuid,size=128m --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 256 THEEB_API_IMAGE
ExecStop=/usr/bin/docker stop --time 30 theeb-api
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
