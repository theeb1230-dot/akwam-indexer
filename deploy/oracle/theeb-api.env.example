NODE_ENV=production
THEEB_ROLE=api
DATABASE_DRIVER=postgres
DATABASE_URL_FILE=/run/secrets/database_url
PGSSLMODE=verify-full
PG_POOL_MAX=3
# Verified by the PostgreSQL runtime E2E gate in CI:
POSTGRES_RUNTIME_PARITY=verified
THEEB_ZERO_COST_ONLY=true
THEEB_DEPLOYMENT_TARGET=oracle-always-free
PORT=8080
# Prefer mounted secret files when the platform provides them:
# THEEB_API_TOKEN_FILE=/run/secrets/api_token
# ADMIN_READ_TOKEN_FILE=/run/secrets/admin_read_token
# Direct values remain supported for external secret-injection systems:
# THEEB_API_TOKEN=
# ADMIN_READ_TOKEN=
# Optional comma-separated cross-origin web origins. Same-origin requests need no entry.
# THEEB_CORS_ORIGINS=https://app.example
