NODE_ENV=production
THEEB_ROLE=health-worker
DATABASE_DRIVER=postgres
DATABASE_URL_FILE=/run/secrets/database_url
PGSSLMODE=verify-full
PG_POOL_MAX=5
JOB_POLL_MS=1000
JOB_LEASE_MS=60000
SHUTDOWN_TIMEOUT_MS=25000
CHROME_PATH=/usr/bin/chromium
# Label persisted with regional health evidence when region-aware health lands.
THEEB_REGION=REPLACE_WITH_REGION
