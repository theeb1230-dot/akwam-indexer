# HTTP port
PORT=3000

# Production security. Generate a random token of at least 32 characters and
# send it as: Authorization: Bearer <token>. Never commit the real value.
# Authentication defaults to enabled and cannot be disabled when
# NODE_ENV=production. This false value is only for local development.
THEEB_AUTH_REQUIRED=false
# THEEB_API_TOKEN=
# Exact number of controlled reverse-proxy hops. Leave unset/0 without one.
THEEB_TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TELEMETRY_RATE_LIMIT_MAX=60
REQUEST_BODY_LIMIT=256kb
MAX_QUERY_LENGTH=200
MAX_IDENTIFIER_LENGTH=500

# Runtime role.
# all: backward-compatible local runtime
# api: HTTP API runtime
# refresh-worker: durable import and refresh jobs
# health-worker: TTL scheduling and verified health probes
THEEB_ROLE=all

# Worker lease and polling defaults (milliseconds)
# JOB_LEASE_MS=60000
# JOB_POLL_MS=1000
# HEALTH_SCHEDULER_MS=30000
# HEALTH_TTL_MS=600000
# HEALTH_FAILURE_TTL_MS=120000
# BROWSER_PROBE_TIMEOUT_MS=30000
# REFRESH_SCHEDULER_MS=60000
# REFRESH_TTL_MS=21600000

# SQLite is local-development storage until the tested PostgreSQL migration.
# DATABASE_PATH=./data/theeb.sqlite
# DATABASE_URL=postgresql://...
# DATABASE_URL_FILE=/run/secrets/database_url
# DATABASE_DRIVER=sqlite
# TLS certificate verification is mandatory: require, verify-ca, or verify-full.
# PGSSLMODE=verify-full
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=10000
# LOG_LEVEL=info

# Read-only admin endpoints
# ADMIN_READ_TOKEN=

# Zero-cost deployment policy
# When enabled, deployment validation rejects known billing-enabled targets.
THEEB_ZERO_COST_ONLY=true
# THEEB_HOSTING_ROLE=primary-api|standby-api|health-worker|refresh-worker|database
# SHUTDOWN_TIMEOUT_MS=25000
# POSTGRES_RUNTIME_PARITY=verified
