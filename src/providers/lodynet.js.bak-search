const axios = require("axios");
const cheerio = require("cheerio");

class LodyNetProvider {
  constructor() {
    this.name = "lodynet";
    this.baseUrl = "https://lodynet.watch";

    this.stopWords = new Set([
      "مسلسل",
      "لمسلسل",
      "مسلسلات",
      "الموسم",
      "موسم",
      "الاول",
      "الأول",
      "الثاني",
      "الثالث",
      "الرابع",
      "الخامس",
      "السادس",
      "السابع",
      "الثامن",
      "الحلقة",
      "حلقة",
      "مترجم",
      "مترجمة",
      "مدبلج",
      "مدبلجة",
      "مشاهدة",
      "turkish",
      "webdl"
    ]);
  }

  clean(value) {
    return String(value || "")
      .replace(/\s+/g, " ")
      .trim();
  }

  absoluteUrl(value) {
    if (!value) return null;

    try {
      return new URL(
        value,
        this.baseUrl
      ).href;
    } catch {
      return null;
    }
  }

  buildUrl(idOrUrl) {
    const value =
      String(idOrUrl || "").trim();

    if (!value) {
      throw new Error(
        "LodyNet URL or ID is required"
      );
    }

    if (
      value.startsWith("http://") ||
      value.startsWith("https://")
    ) {
      return value;
    }

    if (value.startsWith("/")) {
      return `${this.baseUrl}${value}`;
    }

    return `${this.baseUrl}/${value}`;
  }

  decodePath(url) {
    try {
      return decodeURIComponent(
        new URL(url).pathname
      );
    } catch {
      return String(url || "");
    }
  }

  normalizePath(url) {
    return this.decodePath(url)
      .replace(/^\/+/, "")
      .replace(/\/+$/, "");
  }

  async requestPage(url) {
    const response =
      await axios.get(url, {
        timeout: 20000,
        maxRedirects: 5,

        headers: {
          "User-Agent":
            "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 Version/18.0 Mobile/15E148 Safari/604.1",

          "Accept-Language":
            "ar,en;q=0.8"
        },

        validateStatus(status) {
          return (
            status >= 200 &&
            status < 400
          );
        }
      });

    return {
      html: response.data,

      status:
        response.status,

      finalUrl:
        response.request?.res
          ?.responseUrl ||
        url
    };
  }

  extractEpisodeNumber(text, url) {
    const values = [
      this.clean(text),
      this.decodePath(url)
    ];

    const patterns = [
      /الحلقة\s*(\d+)/i,
      /حلقة\s*(\d+)/i
    ];

    for (const value of values) {
      for (const pattern of patterns) {
        const match =
          value.match(pattern);

        if (match) {
          return Number(match[1]);
        }
      }
    }

    return null;
  }

  extractYear(value) {
    const match =
      String(value || "")
        .match(/\b(?:19|20)\d{2}\b/);

    return match
      ? Number(match[0])
      : null;
  }

  extractImage($) {
    const candidates = [
      $('meta[property="og:image"]')
        .attr("content"),

      $('meta[name="twitter:image"]')
        .attr("content"),

      $("img")
        .filter((_, el) => {
          const src =
            $(el).attr("data-src") ||
            $(el).attr("src") ||
            "";

          return !/logo/i.test(src);
        })
        .first()
        .attr("data-src"),

      $("img")
        .filter((_, el) => {
          const src =
            $(el).attr("src") ||
            "";

          return !/logo/i.test(src);
        })
        .first()
        .attr("src")
    ];

    for (const image of candidates) {
      if (image) {
        return this.absoluteUrl(image);
      }
    }

    return null;
  }

  tokenize(value) {
    return this.clean(
      String(value || "")
        .toLowerCase()
        .replace(/[^\p{L}\p{N}]+/gu, " ")
    )
      .split(" ")
      .map(x => x.trim())
      .filter(Boolean)
      .filter(
        x =>
          !this.stopWords.has(x)
      )
      .filter(
        x =>
          !/^\d+$/.test(x)
      )
      .filter(
        x =>
          x.length >= 3
      );
  }

  getIdentityTokens(title, url) {
    return Array.from(
      new Set([
        ...this.tokenize(title),
        ...this.tokenize(
          this.decodePath(url)
        )
      ])
    );
  }

  scoreCandidate(
    candidateText,
    candidateUrl,
    tokens
  ) {
    const candidate =
      this.clean(
        `${candidateText} ${this.decodePath(candidateUrl)}`
      ).toLowerCase();

    let score = 0;

    for (const token of tokens) {
      if (
        candidate.includes(
          token.toLowerCase()
        )
      ) {
        score++;
      }
    }

    return score;
  }

  belongsToSeries(
    text,
    url,
    tokens
  ) {
    if (!tokens.length) {
      return false;
    }

    return (
      this.scoreCandidate(
        text,
        url,
        tokens
      ) > 0
    );
  }

  findBestSeriesUrl(
    $,
    episodeUrl,
    episodeTitle
  ) {
    const tokens =
      this.getIdentityTokens(
        episodeTitle,
        episodeUrl
      );

    const candidates = [];

    $("a[href]").each(
      (_, element) => {
        const href =
          $(element)
            .attr("href");

        if (!href) return;

        const absolute =
          this.absoluteUrl(href);

        if (!absolute) return;

        let parsed;

        try {
          parsed =
            new URL(absolute);
        } catch {
          return;
        }

        if (
          parsed.hostname !==
          "lodynet.watch"
        ) {
          return;
        }

        if (
          !parsed.pathname
            .includes("/category/")
        ) {
          return;
        }

        const text =
          this.clean(
            $(element).text()
          );

        const score =
          this.scoreCandidate(
            text,
            absolute,
            tokens
          );

        if (score <= 0) {
          return;
        }

        candidates.push({
          url: absolute,
          text,
          score
        });
      }
    );

    candidates.sort(
      (a, b) =>
        b.score - a.score
    );

    return (
      candidates[0]?.url ||
      null
    );
  }

  async getSeries(idOrUrl) {
    const url =
      this.buildUrl(idOrUrl);

    const page =
      await this.requestPage(url);

    const $ =
      cheerio.load(page.html);

    const title =
      this.clean(
        $("h1").first().text()
      ) ||
      this.clean(
        $('meta[property="og:title"]')
          .attr("content")
      ) ||
      this.clean(
        $("title").text()
      );

    const description =
      this.clean(
        $('meta[name="description"]')
          .attr("content")
      );

    const image =
      this.extractImage($);

    const identityTokens =
      this.getIdentityTokens(
        title,
        page.finalUrl
      );

    const episodes = [];

    $("a[href]").each(
      (_, element) => {
        const href =
          $(element)
            .attr("href");

        if (!href) return;

        const absolute =
          this.absoluteUrl(href);

        if (!absolute) return;

        let parsed;

        try {
          parsed =
            new URL(absolute);
        } catch {
          return;
        }

        if (
          parsed.hostname !==
          "lodynet.watch"
        ) {
          return;
        }

        const text =
          this.clean(
            $(element).text()
          );

        const number =
          this.extractEpisodeNumber(
            text,
            absolute
          );

        if (
          !Number.isInteger(number) ||
          number <= 0
        ) {
          return;
        }

        if (
          !this.belongsToSeries(
            text,
            absolute,
            identityTokens
          )
        ) {
          return;
        }

        episodes.push({
          id:
            this.normalizePath(
              absolute
            ),

          number,

          title:
            text ||
            `الحلقة ${number}`,

          page_url:
            absolute
        });
      }
    );

    const uniqueEpisodes =
      Array.from(
        new Map(
          episodes.map(
            episode => [
              episode.number,
              episode
            ]
          )
        ).values()
      ).sort(
        (a, b) =>
          a.number -
          b.number
      );

    return {
      provider:
        this.name,

      source_url:
        page.finalUrl,

      series: {
        title,
        description,
        image,

        language:
          "العربية",

        quality:
          null,

        country:
          "تركيا",

        year:
          this.extractYear(
            `${title} ${description}`
          )
      },

      episodes:
        uniqueEpisodes
    };
  }

  async getEpisode(idOrUrl) {
    const url =
      this.buildUrl(idOrUrl);

    const page =
      await this.requestPage(url);

    const $ =
      cheerio.load(page.html);

    const title =
      this.clean(
        $("h1").first().text()
      ) ||
      this.clean(
        $('meta[property="og:title"]')
          .attr("content")
      ) ||
      this.clean(
        $("title").text()
      );

    const description =
      this.clean(
        $('meta[name="description"]')
          .attr("content")
      );

    const image =
      this.extractImage($);

    const seriesUrl =
      this.findBestSeriesUrl(
        $,
        page.finalUrl,
        title
      );

    return {
      provider:
        this.name,

      source_url:
        page.finalUrl,

      episode: {
        id:
          this.normalizePath(
            page.finalUrl
          ),

        title,
        description,
        image,

        series_url:
          seriesUrl
      },

      qualities: [],

      watch_options: []
    };
  }

  async getWatchInfo(
    watchId,
    episodeId
  ) {
    return {
      provider:
        this.name,

      watch: {
        id:
          String(watchId),

        episode_id:
          String(episodeId)
      },

      player:
        "unknown",

      source_count:
        0,

      available_qualities:
        [],

      media_types:
        []
    };
  }
}

module.exports =
  new LodyNetProvider();
