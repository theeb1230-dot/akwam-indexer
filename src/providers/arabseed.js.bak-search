const axios = require("axios");
const cheerio = require("cheerio");

class ArabSeedProvider {
  constructor() {
    this.name = "arabseed";
    this.baseUrl = "https://arabsseed.homes";
  }

  absoluteUrl(url) {
    if (!url) {
      return null;
    }

    try {
      return new URL(
        url,
        this.baseUrl
      ).href;
    } catch {
      return null;
    }
  }

  clean(value) {
    return String(
      value || ""
    )
      .replace(/\s+/g, " ")
      .trim();
  }

  async requestPage(url) {
    const response =
      await axios.get(url, {
        timeout: 20000,

        headers: {
          "User-Agent":
            "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 Version/18.0 Mobile/15E148 Safari/604.1",

          "Accept-Language":
            "ar,en;q=0.8"
        },

        validateStatus(status) {
          return (
            status >= 200 &&
            status < 400
          );
        }
      });

    return response.data;
  }

  async getSeries(idOrUrl) {
    let url;

    if (
      String(idOrUrl)
        .startsWith("http")
    ) {
      url =
        String(idOrUrl);
    } else {
      url =
        `${this.baseUrl}/category.php?cat=${encodeURIComponent(
          String(idOrUrl)
        )}`;
    }

    const html =
      await this.requestPage(url);

    const $ =
      cheerio.load(html);

    const title =
      this.clean(
        $("h1")
          .first()
          .text()
      ) ||
      this.clean(
        $("title")
          .first()
          .text()
      );

    const description =
      this.clean(
        $('meta[name="description"]')
          .attr("content")
      );

    const episodes = [];

    $("a[href]").each(
      (_, element) => {
        const href =
          $(element)
            .attr("href");

        const text =
          this.clean(
            $(element).text()
          );

        if (!href) {
          return;
        }

        const absolute =
          this.absoluteUrl(
            href
          );

        if (!absolute) {
          return;
        }

        const episodeMatch =
          text.match(
            /الحلقة\s*(\d+)/i
          );

        if (!episodeMatch) {
          return;
        }

        const episodeNumber =
          Number(
            episodeMatch[1]
          );

        const vidMatch =
          absolute.match(
            /watch\.php\?vid=([^&#]+)/i
          );

        episodes.push({
          id:
            vidMatch
              ? vidMatch[1]
              : absolute,

          number:
            episodeNumber,

          title:
            text,

          page_url:
            absolute
        });
      }
    );

    const uniqueEpisodes =
      Array.from(
        new Map(
          episodes.map(
            episode => [
              `${episode.number}:${episode.page_url}`,
              episode
            ]
          )
        ).values()
      ).sort(
        (a, b) =>
          a.number -
          b.number
      );

    return {
      provider:
        this.name,

      source_url:
        url,

      series: {
        title,
        description,
        image:
          $('meta[property="og:image"]')
            .attr("content") ||
          null,

        language:
          null,

        quality:
          null,

        country:
          null,

        year:
          null
      },

      episodes:
        uniqueEpisodes
    };
  }

  async getEpisode(idOrUrl) {
    let url;

    if (
      String(idOrUrl)
        .startsWith("http")
    ) {
      url =
        String(idOrUrl);
    } else {
      url =
        `${this.baseUrl}/watch.php?vid=${encodeURIComponent(
          String(idOrUrl)
        )}`;
    }

    const html =
      await this.requestPage(url);

    const $ =
      cheerio.load(html);

    const title =
      this.clean(
        $("h1")
          .first()
          .text()
      ) ||
      this.clean(
        $("title")
          .first()
          .text()
      );

    const description =
      this.clean(
        $('meta[name="description"]')
          .attr("content")
      );

    const vidMatch =
      url.match(
        /[?&]vid=([^&#]+)/i
      );

    return {
      provider:
        this.name,

      source_url:
        url,

      episode: {
        id:
          vidMatch
            ? vidMatch[1]
            : String(idOrUrl),

        title,
        description,

        image:
          $('meta[property="og:image"]')
            .attr("content") ||
          null
      },

      qualities: [],

      watch_options: []
    };
  }

  async getWatchInfo(
    watchId,
    episodeId
  ) {
    return {
      provider:
        this.name,

      watch: {
        id:
          String(watchId),

        episode_id:
          String(episodeId)
      },

      player:
        "unknown",

      source_count:
        0,

      available_qualities:
        [],

      media_types:
        []
    };
  }
}

module.exports =
  new ArabSeedProvider();
