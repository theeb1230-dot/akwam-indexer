{
  "name": "akwam-indexer",
  "version": "1.0.0",
  "description": "Theeb Engine multi-provider media indexer and resolver",
  "main": "src/entrypoint.js",
  "scripts": {
    "start": "node src/entrypoint.js",
    "start:api": "THEEB_ROLE=api node src/entrypoint.js",
    "start:refresh-worker": "THEEB_ROLE=refresh-worker node src/entrypoint.js",
    "start:health-worker": "THEEB_ROLE=health-worker node src/entrypoint.js",
    "dev": "node --watch src/entrypoint.js",
    "test": "node --test",
    "live:test": "node scripts/live-playback-validation.js",
    "db:migrate:postgres": "node scripts/migrate-postgres.js",
    "db:transfer:postgres": "node scripts/transfer-sqlite-to-postgres.js",
    "gate:regression": "node --test test/gates/regression.gate.test.js",
    "gate:security": "node --test test/gates/security.gate.test.js",
    "gate:providers": "node --test test/gates/provider-contract.gate.test.js",
    "gate:live-contract": "node --test test/gates/live-matrix.gate.test.js",
    "gate:harness-contract": "node --test test/gates/harness-contract.gate.test.js",
    "gate:migrations": "node --test test/gates/migration.gate.test.js && node scripts/gates/postgres-migration-drill.js",
    "gate:backup-restore": "node scripts/gates/backup-restore-drill.js",
    "gate:load": "node scripts/gates/load-harness.js",
    "gate:soak": "node scripts/gates/soak-harness.js",
    "gate:golden": "node scripts/gates/run-gates.js",
    "gate:live-matrix": "node scripts/gates/validate-live-matrix.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theeb1230-dot/akwam-indexer.git"
  },
  "keywords": [
    "theeb",
    "indexer",
    "media",
    "multi-provider"
  ],
  "author": "Arab_Theeb",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/theeb1230-dot/akwam-indexer/issues"
  },
  "homepage": "https://github.com/theeb1230-dot/akwam-indexer#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
